{
  "name": "@vorionsys/mcp-server",
  "version": "0.3.1",
  "description": "MCP server for Vorion audit and trust primitives — pre-flight trust checks for tool execution, proof logging, tier lookup, and remote Cognigate Runtime tools",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "vorion-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@vorionsys/proof-plane": "^0.1.4",
    "@vorionsys/sdk": "^0.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "vorion",
    "basis",
    "ai",
    "agent",
    "governance",
    "trust",
    "safety",
    "cognigate"
  ],
  "author": "Vorion LLC <team@vorion.org>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vorionsys/mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/vorionsys/mcp-server/issues"
  },
  "homepage": "https://vorion.org",
  "engines": {
    "node": ">=20.0.0"
  }
}
